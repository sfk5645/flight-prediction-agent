# Copy into Streamlit Cloud → Settings → Secrets
# (or save locally as .streamlit/secrets.toml — gitignored)
# Placeholders only — never put real keys in this file.

GROQ_API_KEY = "REPLACE_WITH_YOUR_GROQ_KEY"
GROQ_MODEL = "llama-3.1-8b-instant"

R2_ACCOUNT_ID = "REPLACE_WITH_ACCOUNT_ID"
R2_ACCESS_KEY_ID = "REPLACE_WITH_ACCESS_KEY_ID"
R2_SECRET_ACCESS_KEY = "REPLACE_WITH_SECRET_ACCESS_KEY"
R2_BUCKET = "flight-prediction-agent"
# Optional if account id is set:
# R2_ENDPOINT_URL = "https://<accountid>.r2.cloudflarestorage.com"
