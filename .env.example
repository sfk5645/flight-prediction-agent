# Local paths
FLIGHT_DATA_DIR=data
FLIGHT_DUCKDB_PATH=data/duckdb/flight_agent.duckdb
# Keep false so gold lives on R2; local .duckdb is deleted after warehouse push.
FLIGHT_DUCKDB_KEEP_LOCAL=false
FLIGHT_MLFLOW_TRACKING_URI=sqlite:///mlflow.db
FLIGHT_MODEL_DIR=models/local

# Cloudflare R2 (optional — local Parquet works without these)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=flight-prediction-agent
R2_ENDPOINT_URL=
# Direct-to-R2 ingest example:
#   uv run flight ingest all --to-r2 --no-keep-local
# Then transform from the bucket:
#   uv run flight dbt build --from-r2

# Hugging Face (optional — publish model/dataset)
HF_TOKEN=
HF_REPO_ID=your-username/flight-delay-model
HF_DATASET_REPO_ID=your-username/flight-delay-sample

# Groq agent LLM (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Streamlit Community Cloud: paste the same keys into App → Settings → Secrets
# (see .streamlit/secrets.toml.example). GitHub Actions pushes models/ to R2.
# Optional: FLIGHT_SERVE_CACHE_DIR=/tmp/flight_serve_cache

# API
FLIGHT_API_HOST=127.0.0.1
FLIGHT_API_PORT=8000
